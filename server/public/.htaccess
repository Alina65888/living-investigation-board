# Living Project HQ on ordinary hosting: static app + PHP API under /api/.
DirectoryIndex index.html
Options -Indexes

RewriteEngine On
# Everything under /api/ goes to the PHP front controller.
RewriteRule ^api/(?!index\.php$) api/index.php [L,QSA]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>
