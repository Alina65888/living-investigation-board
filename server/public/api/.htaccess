# Only index.php is reachable from the web; lib.php and config.php are included by it.
<IfModule mod_authz_core.c>
  Require all denied
  <Files "index.php">
    Require all granted
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <Files "index.php">
    Allow from all
  </Files>
</IfModule>
