# Only index.php is meant for the browser: block the files it includes.
# A deny-list (not "deny all + allow index.php") so hostings that pass PHP to FPM do not answer 403.
<FilesMatch "^(lib|config|config\.sample)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
